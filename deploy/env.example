# Copy to .env locally (do not commit secrets). Render sets many of these in the dashboard.
#
# PORT — HTTP listen port (Render injects this automatically for Web Services).
# PORT=8080

# JVM heap / ergonomics (passed through Dockerfile ENTRYPOINT via JAVA_OPTS).
# JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# Spring profile — enables application-prod.properties
# SPRING_PROFILES_ACTIVE=prod

# WAL filesystem path (must be writable; use a persistent disk mount on Render)
# MEMTSDB_WAL_PATH=/data/wal/metrics.wal

# Disable startup replay if you know the WAL is empty or incompatible (recoveries / migrations)
# MEMTSDB_WAL_REPLAY_ENABLED=true

# WAL async queue depth (back-pressure vs memory)
# MEMTSDB_WAL_QUEUE_CAPACITY=65536
